# Supabase (for realtime metadata/state)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PortKey AI — set to connect the AI agent (server-side only)
PORTKEY_API_KEY=
PORTKEY_CONFIG_ID=
PORTKEY_MODEL=gpt-4o-mini
# PORTKEY_BASE_URL=https://api.portkey.ai/v1

# GitHub OAuth (for GitHub integration)
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Git Mirror (local git storage path)
GIT_MIRROR_ROOT=.git-mirror
